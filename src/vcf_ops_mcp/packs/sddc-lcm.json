{
  "schema_version": 1,
  "id": "sentania.sddc-lcm.read",
  "version": "0.2.0",
  "backend": "sddc-lcm",
  "endpoint": "sddc-lcm",
  "product": "VCF SDDC Lifecycle",
  "auth_scheme": "bearer_token",
  "api_root": "/sddc-lcm",
  "source": "vmware/vcf-api-specs specifications/sddc-lcm/sddc-lcm-openapi.yaml, Apache-2.0",
  "source_kind": "official",
  "unsigned": true,
  "caps": {"max_list_items": 4000, "max_response_bytes": 8388608},
  "projection_keys": ["id", "name", "description", "type", "status", "state", "scope", "version", "componentId", "componentType", "resourceId", "resourceType", "createdBy", "startTime", "updateTime", "endTime", "health", "config", "nodes", "components", "backups", "supportBundles", "tasks", "elements", "items", "count", "pageNumber", "pageSize", "totalElements", "totalPages"],
  "tools": [
    {"name":"get_sddc_lcm_health","summary":"Get VCF SDDC Lifecycle health.","capability":"read:lifecycle","method":"GET","path":"/v1/health","projection":"sddc-lcm.read.v1"},
    {"name":"get_sddc_lcm_config","summary":"Get VCF SDDC Lifecycle configuration.","capability":"read:lifecycle","method":"GET","path":"/v1/config","projection":"sddc-lcm.read.v1"},
    {"name":"list_sddc_lcm_components","summary":"List components registered with VCF SDDC Lifecycle.","capability":"read:lifecycle","method":"GET","path":"/v1/components","query":["scope"],"projection":"sddc-lcm.read.v1","arguments":[{"name":"scope","type":"str?","default":null,"location":"query"}]},
    {"name":"list_sddc_lcm_component_backups","summary":"List VCF SDDC Lifecycle component backups.","capability":"read:lifecycle","method":"GET","path":"/v1/components/backups","query":["componentId","periodStart","periodEnd"],"projection":"sddc-lcm.read.v1","arguments":[{"name":"component_id","wire_name":"componentId","type":"str?","default":null,"location":"query"},{"name":"period_start","wire_name":"periodStart","type":"str?","default":null,"location":"query"},{"name":"period_end","wire_name":"periodEnd","type":"str?","default":null,"location":"query"}]},
    {"name":"get_sddc_lcm_component","summary":"Get one VCF SDDC Lifecycle component.","capability":"read:lifecycle","method":"GET","path":"/v1/components/{componentId}","projection":"sddc-lcm.read.v1","arguments":[{"name":"component_id","wire_name":"componentId","type":"str","required":true,"location":"path"}]},
    {"name":"get_sddc_lcm_component_config","summary":"Get configuration for one VCF SDDC Lifecycle component.","capability":"read:lifecycle","method":"GET","path":"/v1/components/{componentId}/config","projection":"sddc-lcm.read.v1","response_keys":["type","size","items","count"],"arguments":[{"name":"component_id","wire_name":"componentId","type":"str","required":true,"location":"path"}]},
    {"name":"list_sddc_lcm_component_nodes","summary":"List nodes for one VCF SDDC Lifecycle component.","capability":"read:lifecycle","method":"GET","path":"/v1/components/{componentId}/nodes","query":["pageNumber","pageSize","nodeTypes"],"projection":"sddc-lcm.read.v1","arguments":[{"name":"component_id","wire_name":"componentId","type":"str","required":true,"location":"path"},{"name":"node_types","wire_name":"nodeTypes","type":"list[str]?","default":null,"location":"query"},{"name":"page_number","wire_name":"pageNumber","type":"int","default":1,"location":"query"},{"name":"page_size","wire_name":"pageSize","type":"int","default":50,"location":"query"}]},
    {"name":"get_sddc_lcm_component_status","summary":"Get status for one VCF SDDC Lifecycle component.","capability":"read:lifecycle","method":"GET","path":"/v1/components/{componentId}/status","projection":"sddc-lcm.read.v1","arguments":[{"name":"component_id","wire_name":"componentId","type":"str","required":true,"location":"path"}]},
    {"name":"list_sddc_lcm_component_support_bundles","summary":"List support bundles for one VCF SDDC Lifecycle component.","capability":"read:lifecycle","method":"GET","path":"/v1/components/{componentId}/support-bundles","projection":"sddc-lcm.read.v1","arguments":[{"name":"component_id","wire_name":"componentId","type":"str","required":true,"location":"path"}]},
    {"name":"list_sddc_lcm_tasks","summary":"List VCF SDDC Lifecycle tasks.","capability":"read:lifecycle","method":"GET","path":"/v1/tasks","query":["status","type","resourceId","resourceType","includeSystemTasks","pageNumber","pageSize"],"projection":"sddc-lcm.read.v1","arguments":[{"name":"status","type":"str?","default":null,"location":"query"},{"name":"task_type","wire_name":"type","type":"str?","default":null,"location":"query"},{"name":"resource_id","wire_name":"resourceId","type":"str?","default":null,"location":"query"},{"name":"resource_type","wire_name":"resourceType","type":"str?","default":null,"location":"query"},{"name":"include_system_tasks","wire_name":"includeSystemTasks","type":"bool","default":false,"location":"query"},{"name":"page_number","wire_name":"pageNumber","type":"int","default":1,"location":"query"},{"name":"page_size","wire_name":"pageSize","type":"int","default":50,"location":"query"}]},
    {"name":"get_sddc_lcm_task","summary":"Get one VCF SDDC Lifecycle task.","capability":"read:lifecycle","method":"GET","path":"/v1/tasks/{taskId}","projection":"sddc-lcm.read.v1","arguments":[{"name":"task_id","wire_name":"taskId","type":"str","required":true,"location":"path"}]},
    {"name":"get_sddc_lcm_component_statuses","summary":"Read status for an explicit set of VCF SDDC Lifecycle components.","capability":"read:lifecycle","method":"POST","path":"/v1/components/status","body":["componentIds"],"body_template":{"componentIds":{"$argument":"component_ids"}},"projection":"sddc-lcm.read.v1","arguments":[{"name":"component_ids","type":"list[str]","required":true}]},
    {"name":"list_sddc_lcm_fleet_components","summary":"List fleet-scoped VCF SDDC Lifecycle components.","capability":"read:lifecycle","method":"GET","path":"/v1/components","query":["scope"],"fixed_query":{"scope":"FLEET"},"projection":"sddc-lcm.read.v1"},
    {"name":"list_sddc_lcm_instance_components","summary":"List instance-scoped VCF SDDC Lifecycle components.","capability":"read:lifecycle","method":"GET","path":"/v1/components","query":["scope"],"fixed_query":{"scope":"INSTANCE"},"projection":"sddc-lcm.read.v1"},
    {"name":"list_failed_sddc_lcm_tasks","summary":"List failed VCF SDDC Lifecycle tasks.","capability":"read:lifecycle","method":"GET","path":"/v1/tasks","query":["status","pageNumber","pageSize"],"fixed_query":{"status":"FAILED"},"projection":"sddc-lcm.read.v1","arguments":[{"name":"page_number","wire_name":"pageNumber","type":"int","default":1,"location":"query"},{"name":"page_size","wire_name":"pageSize","type":"int","default":50,"location":"query"}]},
    {"name":"list_running_sddc_lcm_tasks","summary":"List running VCF SDDC Lifecycle tasks.","capability":"read:lifecycle","method":"GET","path":"/v1/tasks","query":["status","pageNumber","pageSize"],"fixed_query":{"status":"IN_PROGRESS"},"projection":"sddc-lcm.read.v1","arguments":[{"name":"page_number","wire_name":"pageNumber","type":"int","default":1,"location":"query"},{"name":"page_size","wire_name":"pageSize","type":"int","default":50,"location":"query"}]},
    {"name":"list_sddc_lcm_tasks_for_component","summary":"List VCF SDDC Lifecycle tasks for one component.","capability":"read:lifecycle","method":"GET","path":"/v1/tasks","query":["resourceId","resourceType","pageNumber","pageSize"],"fixed_query":{"resourceType":"COMPONENT"},"projection":"sddc-lcm.read.v1","arguments":[{"name":"component_id","wire_name":"resourceId","type":"str","required":true,"location":"query"},{"name":"page_number","wire_name":"pageNumber","type":"int","default":1,"location":"query"},{"name":"page_size","wire_name":"pageSize","type":"int","default":50,"location":"query"}]},
    {"name":"list_recent_sddc_lcm_tasks","summary":"List VCF SDDC Lifecycle tasks started after a timestamp.","capability":"read:lifecycle","method":"GET","path":"/v1/tasks","query":["startTimeGt","pageNumber","pageSize"],"projection":"sddc-lcm.read.v1","arguments":[{"name":"started_after","wire_name":"startTimeGt","type":"str","required":true,"location":"query"},{"name":"page_number","wire_name":"pageNumber","type":"int","default":1,"location":"query"},{"name":"page_size","wire_name":"pageSize","type":"int","default":50,"location":"query"}]},
    {"name":"list_sddc_lcm_system_tasks","summary":"List system tasks from VCF SDDC Lifecycle.","capability":"read:lifecycle","method":"GET","path":"/v1/tasks","query":["includeSystemTasks","pageNumber","pageSize"],"fixed_query":{"includeSystemTasks":true},"projection":"sddc-lcm.read.v1","arguments":[{"name":"page_number","wire_name":"pageNumber","type":"int","default":1,"location":"query"},{"name":"page_size","wire_name":"pageSize","type":"int","default":50,"location":"query"}]}
  ]
}
