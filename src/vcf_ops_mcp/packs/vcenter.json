  "version": "0.1.0-prototype",
  "backend": "vcenter",
  "endpoint": "vcenter",
  "product": "vCenter Server",
  "auth_scheme": "vcenter_session",
  "api_root": "",
  "source": "vmware/vcf-api-specs specifications/vsphere/openapi/automation, Apache-2.0",
  "unsigned": true,
  "projection_keys": ["vm", "host", "name", "power_state", "connection_state", "guest_OS", "cpu", "memory", "hardware", "user", "created_time", "last_accessed_time", "items", "count"],
  "caps": {"max_list_items": 4000, "max_response_bytes": 8388608},
  "tools": [
    {"name":"list_vcenter_vms","summary":"List visible virtual machines with optional server-side filters.","capability":"read:inventory","method":"GET","path":"/api/vcenter/vm","query":["clusters","datacenters","folders","hosts","names","power_states","resource_pools","vms"],"projection":"vcenter_vm_summary.v1","arguments":[{"name":"names","type":"list[str]?","default":null},{"name":"power_states","type":"list[str]?","default":null},{"name":"vms","type":"list[str]?","default":null},{"name":"folders","type":"list[str]?","default":null},{"name":"datacenters","type":"list[str]?","default":null},{"name":"hosts","type":"list[str]?","default":null},{"name":"clusters","type":"list[str]?","default":null},{"name":"resource_pools","type":"list[str]?","default":null}]},
    {"name":"get_vcenter_vm","summary":"Get detailed configuration for one virtual machine.","capability":"read:inventory","method":"GET","path":"/api/vcenter/vm/{vm}","projection":"vcenter_vm_detail.v1","arguments":[{"name":"vm","type":"str","required":true}]},
    {"name":"list_vcenter_hosts","summary":"List visible ESXi hosts with optional server-side filters.","capability":"read:inventory","method":"GET","path":"/api/vcenter/host","query":["clusters","connection_states","datacenters","hosts","names","standalone"],"projection":"vcenter_host_summary.v1","arguments":[{"name":"names","type":"list[str]?","default":null},{"name":"connection_states","type":"list[str]?","default":null},{"name":"hosts","type":"list[str]?","default":null},{"name":"datacenters","type":"list[str]?","default":null},{"name":"clusters","type":"list[str]?","default":null},{"name":"standalone","type":"bool?","default":null}]},
    {"name":"get_vcenter_session","summary":"Read the identity and timestamps for this vCenter API session.","capability":"read:inventory","method":"GET","path":"/api/session","projection":"vcenter_session.v1"}
  ]
}
