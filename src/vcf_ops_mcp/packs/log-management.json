{
  "schema_version": 1,
  "id": "sentania.log-management.read",
  "version": "0.2.0",
  "backend": "log-management",
  "endpoint": "log-management",
  "product": "VCF Log Management",
  "auth_scheme": "ops_exchange",
  "api_root": "",
  "source": "vmware/vcf-api-specs specifications/vcf-operations/log-management-openapi.json, Apache-2.0",
  "source_kind": "official",
  "unsigned": true,
  "caps": {"max_list_items": 2000, "max_response_bytes": 8388608},
  "projection_keys": ["id", "name", "description", "status", "state", "type", "fieldName", "fieldType", "hostname", "source", "appname", "severity", "text", "timestamp", "agentGroups", "extractedFields", "forwarders", "hits", "events", "documents", "aggregations", "total", "value", "scrollId", "scroll_id", "items", "count", "page", "size"],
  "tools": [
    {"name":"list_log_agent_groups","summary":"List VCF Log Management agent groups.","capability":"read:logs","method":"GET","path":"/api/v2/agent/groups","query":["pageable"],"projection":"log-management.read.v1","arguments":[{"name":"pageable","type":"str?","default":null,"location":"query"}]},
    {"name":"get_log_agent_group","summary":"Get one VCF Log Management agent group.","capability":"read:logs","method":"GET","path":"/api/v2/agent/groups/{id}","projection":"log-management.read.v1","arguments":[{"name":"group_id","wire_name":"id","type":"str","required":true,"location":"path"}]},
    {"name":"list_log_agent_secrets","summary":"List projected VCF Log Management agent-secret metadata without secret values.","capability":"read:logs","method":"GET","path":"/api/v2/agent/secrets","query":["pageable"],"projection":"log-management.read.v1","arguments":[{"name":"pageable","type":"str?","default":null,"location":"query"}]},
    {"name":"list_log_extracted_fields","summary":"List extracted fields in VCF Log Management.","capability":"read:logs","method":"GET","path":"/api/v2/fields/extractedFields","projection":"log-management.read.v1"},
    {"name":"list_log_forwarders","summary":"List VCF Log Management forwarders.","capability":"read:logs","method":"GET","path":"/api/v2/logs/forwarders","projection":"log-management.read.v1"},
    {"name":"get_log_forwarder","summary":"Get one VCF Log Management forwarder.","capability":"read:logs","method":"GET","path":"/api/v2/logs/forwarders/{id}","projection":"log-management.read.v1","arguments":[{"name":"forwarder_id","wire_name":"id","type":"str","required":true,"location":"path"}]},
    {"name":"search_log_messages","summary":"Search VCF Log Management for an exact message phrase.","capability":"read:logs","method":"POST","path":"/api/v2/search","body":["query","size"],"body_template":{"query":{"match_phrase":{"text":{"$argument":"phrase"}}},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"phrase","type":"str","required":true},{"name":"size","type":"int","default":100}]},
    {"name":"search_log_message_prefix","summary":"Search VCF Log Management by message prefix.","capability":"read:logs","method":"POST","path":"/api/v2/search","body":["query","size"],"body_template":{"query":{"prefix":{"text":{"$argument":"prefix"}}},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"prefix","type":"str","required":true},{"name":"size","type":"int","default":100}]},
    {"name":"search_logs_by_hostname","summary":"Search VCF Log Management for one hostname.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["query","size"],"body_template":{"query":{"match_phrase":{"hostname":{"$argument":"hostname"}}},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"hostname","type":"str","required":true},{"name":"size","type":"int","default":100}]},
    {"name":"search_logs_by_source","summary":"Search VCF Log Management for one source.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["query","size"],"body_template":{"query":{"match_phrase":{"source":{"$argument":"source"}}},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"source","type":"str","required":true},{"name":"size","type":"int","default":100}]},
    {"name":"search_logs_by_application","summary":"Search VCF Log Management for one application name.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["query","size"],"body_template":{"query":{"match_phrase":{"appname":{"$argument":"application"}}},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"application","type":"str","required":true},{"name":"size","type":"int","default":100}]},
    {"name":"search_logs_by_severity","summary":"Search VCF Log Management for one severity.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["query","size"],"body_template":{"query":{"match_phrase":{"severity":{"$argument":"severity"}}},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"severity","type":"str","required":true},{"name":"size","type":"int","default":100}]},
    {"name":"search_logs_in_window","summary":"Search VCF Log Management within an explicit timestamp window.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["query","size"],"body_template":{"query":{"range":{"timestamp":{"gte":{"$argument":"start"},"lte":{"$argument":"end"}}}},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"start","type":"str","required":true},{"name":"end","type":"str","required":true},{"name":"size","type":"int","default":100}]},
    {"name":"search_logs_by_regular_expression","summary":"Search VCF Log Management messages with a regular expression.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["query","size"],"body_template":{"query":{"regexp":{"text":{"$argument":"expression"}}},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"expression","type":"str","required":true},{"name":"size","type":"int","default":100}]},
    {"name":"list_logs_from_indices","summary":"List logs from an explicit set of VCF Log Management indices.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["query","indices","size"],"body_template":{"query":{"match_all":{}},"indices":{"$argument":"indices"},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"indices","type":"list[str]","required":true},{"name":"size","type":"int","default":100}]},
    {"name":"list_log_page","summary":"List one bounded page of VCF Log Management results.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["query","from","size"],"body_template":{"query":{"match_all":{}},"from":{"$argument":"offset"},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"offset","type":"int","default":0},{"name":"size","type":"int","default":100}]},
    {"name":"count_log_message_matches","summary":"Count VCF Log Management results matching an exact message phrase.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["query","size","trackTotalHits"],"body_template":{"query":{"match_phrase":{"text":{"$argument":"phrase"}}},"size":0,"trackTotalHits":true},"projection":"log-management.read.v1","arguments":[{"name":"phrase","type":"str","required":true}]},
    {"name":"start_log_scroll","summary":"Start a bounded VCF Log Management scroll query.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["query","scroll","scrollSize","size"],"body_template":{"query":{"match_all":{}},"scroll":{"$argument":"keep_alive"},"scrollSize":{"$argument":"scroll_size"},"size":{"$argument":"size"}},"projection":"log-management.read.v1","arguments":[{"name":"keep_alive","type":"str","default":"1m"},{"name":"scroll_size","type":"int","default":500},{"name":"size","type":"int","default":100}]},
    {"name":"continue_log_scroll","summary":"Continue a VCF Log Management scroll query.","capability":"read:logs","method":"POST","path":"/api/v2/logs/search","body":["scroll","scrollSize"],"body_template":{"scroll":{"$argument":"scroll_id"},"scrollSize":{"$argument":"scroll_size"}},"projection":"log-management.read.v1","arguments":[{"name":"scroll_id","type":"str","required":true},{"name":"scroll_size","type":"int","default":500}]}
  ]
}
