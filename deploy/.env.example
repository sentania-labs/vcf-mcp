# Optional runtime overrides for direct docker or uvicorn operation.
#
# The production compose path does not require this file. The lab deployment
# owns the image pin, and the service creates SESSION_SECRET on the /keys
# volume at first start. This template documents supported overrides without
# providing or requesting a real secret value.

# Persistent application paths. The defaults already match deploy/compose.yml.
#SESSION_SECRET_PATH=/keys/session_secret
#CONFIG_DB_PATH=/data/config.sqlite3
#CREDENTIAL_KEYRING_PATH=/keys/credential_keyring.json
#ADMIN_BOOTSTRAP_PASSWORD_FILE=/keys/admin_bootstrap_password
#AUDIT_DB_PATH=/audit/audit.sqlite3
#SKILLS_PATH=/app/skills

# Public base URL used in MCP protected-resource metadata.
#PUBLIC_BASE_URL=https://vcf-ops-mcp.int.sentania.net

# An operator-managed SESSION_SECRET override remains supported for direct
# process operation. It must contain at least 32 bytes on one line. Leaving it
# unset is the normal container path and creates /keys/session_secret at mode
# 0600. Never commit a real value.
#SESSION_SECRET=<optional operator-managed value>

#LOG_LEVEL=INFO
