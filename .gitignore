# Runtime state that must never enter the repo (see CLAUDE.md invariants):
# credential stores, key material, audit logs, minted API keys, session
# tokens. These are volume-mounted at runtime; gitignored defensively.
.secrets/
*.keyfile
credstore*
audit.log*
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env
.env.*

