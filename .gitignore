# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/
.runtime-check.*/

# Runtime state that must never enter the repo (see CLAUDE.md invariants):
# credential stores, key material, audit logs, minted API keys, session
# tokens. These are volume-mounted at runtime; gitignored defensively.
.secrets/
*.keyfile
credstore*
audit.log*
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
.env
.env.*
# The slot .env contract is a template with no real value in it, and it has to
# be readable in the repo for anyone provisioning a slot.
!.env.example

.DS_Store
